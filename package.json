{
  "name": "mu-ui-pro-vue3",
  "version": "1.1.0",
  "description": "A Vue 3 PC UI component library",
  "main": "./dist/mu-ui-pro-vue3.umd.js",
  "module": "./dist/mu-ui-pro-vue3.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/mu-ui-pro-vue3.es.js",
      "require": "./dist/mu-ui-pro-vue3.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:lib": "vite build && npm run build:dts",
    "build:dts": "vue-tsc --project tsconfig.dts.json",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "pub": "npm run build:lib && npm publish",
    "test:unit": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "component",
    "pc",
    "mu-ui"
  ],
  "author": "ty-mt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeWei92/mu-ui-pro-vue3.git"
  },
  "homepage": "https://github.com/yeWei92/mu-ui-pro-vue3#readme",
  "bugs": {
    "url": "https://github.com/yeWei92/mu-ui-pro-vue3/issues"
  },
  "peerDependencies": {
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.9",
    "sass": "^1.101.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitepress": "^2.0.0-alpha.18",
    "vitest": "^4.1.2",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
